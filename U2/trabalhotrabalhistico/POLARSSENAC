df_duracao = consultar(
    """
    SELECT duration
    FROM movie_metadata
    ORDER BY duration DESC
    """,
    salvar_como="duracao_filmes.parquet",
).drop_nulls()

plt.figure(figsize=(10, 5))
sns.histplot(data=df_duracao.to_pandas(), x="duration", bins=30)
plt.title("Distribuição da duração dos filmes (min)")
plt.show()


df_genero = consultar(
    """
    SELECT genres, COUNT(*) AS quantidade
    FROM movie_metadata
    GROUP BY genres
    ORDER BY quantidade DESC
    """,
    salvar_como="filmes_por_genero.parquet",
)

plt.figure(figsize=(10, 6))
sns.barplot(data=df_genero.head(15).to_pandas(), x="quantidade", y="genres")
plt.title("Top 15 gêneros")
plt.show()

