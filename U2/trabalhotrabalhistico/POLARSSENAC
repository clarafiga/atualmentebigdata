def consultar(query: str, salvar_como: str | None = None) -> pl.DataFrame:
    """Executa a query, retorna um DataFrame Polars e opcionalmente salva em parquet."""
    df = pl.read_database(query=query, connection=engine)
    if salvar_como:
        df.write_parquet(PASTA_DADOS/salvar_como)
    return df


