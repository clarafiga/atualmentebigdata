def consultar(query: str, salvar_como: str | None = None) -> pl.DataFrame | None:
    """Executa a query e devolve um DataFrame Polars (ou None em caso de erro)."""
    conexao = None
    cursor = None
    try:
        conexao = mysql.connector.connect(**CONFIG_DB)
        cursor = conexao.cursor()
        cursor.execute(query)

        colunas = [c[0] for c in cursor.description]
        linhas = cursor.fetchall()

        df = pl.DataFrame(linhas, schema=colunas, orient="row")

        if salvar_como:
            df.write_parquet(PASTA_DADOS / salvar_como)
        return df

    except mysql.connector.Error as erro:
        print(f"Erro ao conectar ao MySQL: {erro}")
        return None

    finally:
        if cursor is not None:
            cursor.close()
        if conexao is not None and conexao.is_connected():
            conexao.close()

